# Copy to .env and fill in. Never commit .env.

# --- Database (Neon free tier) ---
# Pooled connection string (host contains "-pooler"). Used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"
# Direct (non-pooled) connection string: same as above without "-pooler". Used only by `prisma migrate`.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=verify-full"

# --- Secrets (generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))") ---
# Shared secret for the cron endpoints. cron-job.org must send "Authorization: Bearer <CRON_SECRET>".
# Vercel Cron sends this header automatically when CRON_SECRET is set in the project.
CRON_SECRET=""
# HMAC key for session ids and rate-limit keys. Changing it signs everyone out.
SESSION_SECRET=""

# --- Public URL of the app (used in alert emails and push notifications) ---
APP_URL="http://localhost:3000"

# --- Email alerts (Resend, free tier: 100 emails/day) ---
# https://resend.com/api-keys
RESEND_API_KEY=""
# Sender. "onboarding@resend.dev" works without a domain but only delivers to your own Resend account email.
# Verify a domain in Resend to email any address.
EMAIL_FROM="Heartbeat <onboarding@resend.dev>"

# --- Web push alerts (VAPID) ---
# Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact for push services, as mailto: or https: URL.
VAPID_SUBJECT="mailto:you@example.com"

# --- Local development only ---
# Password for the DEMO account created by `npm run db:seed`. Leave empty to get a random one printed.
SEED_DEMO_PASSWORD=""
